    (See accompanying file LICENSE_1_0.txt or copy at http://www.boost.org/LICENSE_1_0.txt)

    Ported from ASL's classic `image_size` Adam sheet. adam-lang has no separate
    input/constant/interface/output/invariant sections, no `unlink`, and no `when (expr)
    relate {}` guard on an arbitrary boolean expression — only `conditional match_cell {
    literal => {...} }`, dispatching on one cell's own value. The translation below:
      - ASL `constant`/one-directional `<==` rules -> a `relationship` with a single method
        (the planner always derives that cell; there is no alternative method to pick).
      - ASL `when (cond) relate {}` -> `conditional cond { true => {...} false => {...} }`.
      - ASL `when (a && b) relate {}` -> a derived helper bool cell for `a && b`
        (`resample_and_constrain`), then `conditional` on that helper.
      - ASL `unlink x : init <== cond ? x : fallback;` -> `conditional cond`'s "false" branch
        forces `x` back to `fallback`; its "true" branch leaves `x` untouched (a free,
        directly writable cell), matching the checkbox-like behavior `unlink` describes.
      - ASL's `@bicubic`/`@draft`/etc. symbolic tags -> `String` literals (adam-lang has no
        atom/enum literal).
    The `result` output is approximated as a single tuple `(command, width, height,
    resolution, scale_styles, resample_method)`, command first — adam-lang has no
    tagged-union/struct output type, only tuples. Unlike ASL, the pixel/scale_styles/
    resample_method fields are present (and treated as relevant) even in the
    `set_resolution` case, where ASL would omit them entirely.
*/
sheet image_resize {
    // --- input ---
    cell original_width: i32 = 1600;
    cell original_height: i32 = 1200;
    cell original_resolution: f64 = 300.0;

    // --- constant (derived once from input; never a source) ---
    cell original_doc_width: f64;
    cell original_doc_height: f64;

    // --- interface ---
    cell resample: bool = true;
    cell constrain: bool = true;
    // Helper for ASL's `when (constrain && resample)` / `unlink scale_styles`'s compound
    // guard: adam-lang's `conditional` can only dispatch on one cell's own value.
    cell resample_and_constrain: bool = true;
    cell scale_styles: bool = true;

    cell resample_method: String = "bicubic";

    cell dim_width_pixels: i32 = 1600;
    cell dim_width_percent: f64 = 100.0;

    cell dim_height_pixels: i32 = 1200;
    cell dim_height_percent: f64 = 100.0;

    cell doc_width_inches: f64 = 5.333333333333333;
    cell doc_width_percent: f64 = 100.0;

    // Resolution is declared before the height/inches cells below, mirroring the ASL
    // source's own comment: "Resolution must be initialized before width and height
    // inches to allow proportions to be constrained." adam-rs assigns each cell's initial
    // solver priority from declaration order, so this ordering is preserved best-effort;
    // the two solvers don't guarantee identical tie-breaking.
    cell doc_resolution: f64 = 300.0;

    cell doc_height_inches: f64 = 4.0;
    cell doc_height_percent: f64 = 100.0;

    cell auto_quality: String = "draft";

    // ASL leaves this uninitialized ("initialized from doc_resolution"), relying on
    // its solver to seed it from doc_resolution's *current* value before first use.
    // adam-lang cell initializers are literals only, and the planner's strength-based
    // release order can pick screen_lpi itself as the free source rather than deriving
    // it from doc_resolution — so unlike the sheet's other derived cells, leaving this
    // at a default 0.0 does NOT get corrected by the first propagate(); it must already
    // be consistent with doc_resolution's own default (300.0) at the default "draft"
    // quality (factor 1): 300.0 / 1 = 300.0.
    cell screen_lpi: f64 = 300.0;

    // --- logic ---

    relationship {
        method [original_width, original_resolution] -> [original_doc_width] {
            original_width as f64 / original_resolution
        }
    }
    relationship {
        method [original_height, original_resolution] -> [original_doc_height] {
            original_height as f64 / original_resolution
        }
    }

    relationship {
        method [resample, constrain] -> [resample_and_constrain] { resample && constrain }
    }

    // Unconditional: doc_width_inches <-> doc_width_percent, pinned to original_doc_width.
    relationship {
        method [doc_width_percent, original_doc_width] -> [doc_width_inches] {
            doc_width_percent * original_doc_width / 100.0
        }
        method [doc_width_inches, original_doc_width] -> [doc_width_percent] {
            doc_width_inches * 100.0 / original_doc_width
        }
    }

    // Unconditional: doc_height_inches <-> doc_height_percent, pinned to original_doc_height.
    relationship {
        method [doc_height_percent, original_doc_height] -> [doc_height_inches] {
            doc_height_percent * original_doc_height / 100.0
        }
        method [doc_height_inches, original_doc_height] -> [doc_height_percent] {
            doc_height_inches * 100.0 / original_doc_height
        }
    }


    relationship {
        method [doc_resolution, auto_quality] -> [screen_lpi] { doc_resolution / if auto_quality == "draft" { 1.0 } else if auto_quality == "good" { 1.5 } else { 2.0 } }
        method [screen_lpi, auto_quality] -> [doc_resolution] { screen_lpi * if auto_quality == "draft" { 1.0 } else if auto_quality == "good" { 1.5 } else { 2.0 } }
    }


    conditional resample {
        true => {
            relationship {
                method [dim_width_percent, original_width] -> [dim_width_pixels] {
                    round(dim_width_percent * original_width as f64 / 100.0) as i32
                }
                method [dim_width_pixels, original_width] -> [dim_width_percent] {
                    dim_width_pixels as f64 * 100.0 / original_width as f64
                }
            }
            relationship {
                method [dim_height_percent, original_height] -> [dim_height_pixels] {
                    round(dim_height_percent * original_height as f64 / 100.0) as i32
                }
                method [dim_height_pixels, original_height] -> [dim_height_percent] {
                    dim_height_pixels as f64 * 100.0 / original_height as f64
                }
            }
            relationship {
                method [dim_width_pixels, doc_resolution] -> [doc_width_inches] {
                    dim_width_pixels as f64 / doc_resolution
                }
                method [doc_width_inches, doc_resolution] -> [dim_width_pixels] {
                    round(doc_width_inches * doc_resolution) as i32
                }
                method [dim_width_pixels, doc_width_inches] -> [doc_resolution] {
                    dim_width_pixels as f64 / doc_width_inches
                }
            }
            relationship {
                method [dim_height_pixels, doc_resolution] -> [doc_height_inches] {
                    dim_height_pixels as f64 / doc_resolution
                }
                method [doc_height_inches, doc_resolution] -> [dim_height_pixels] {
                    round(doc_height_inches * doc_resolution) as i32
                }
                method [dim_height_pixels, doc_height_inches] -> [doc_resolution] {
                    dim_height_pixels as f64 / doc_height_inches
                }
            }
        }
        false => {
            // unlink constrain: true <== resample ? constrain : true;
            relationship {
                method [resample] -> [constrain] { true }
            }
            // dim_width_pixels/percent snap back to the un-resampled defaults.
            relationship {
                method [original_width] -> [dim_width_pixels, dim_width_percent] {
                    (original_width, 100.0)
                }
            }
            relationship {
                method [original_height] -> [dim_height_pixels, dim_height_percent] {
                    (original_height, 100.0)
                }
            }
            relationship {
                method [doc_width_inches, original_width] -> [doc_resolution] {
                    original_width as f64 / doc_width_inches
                }
                method [doc_resolution, original_width] -> [doc_width_inches] {
                    original_width as f64 / doc_resolution
                }
            }
            relationship {
                method [doc_height_inches, original_height] -> [doc_resolution] {
                    original_height as f64 / doc_height_inches
                }
                method [doc_resolution, original_height] -> [doc_height_inches] {
                    original_height as f64 / doc_resolution
                }
            }
        }
    }

    conditional resample_and_constrain {
        true => {
            // when (constrain && resample) relate: lock width/height percent together.
            relationship {
                method [dim_width_percent] -> [dim_height_percent] { dim_width_percent }
                method [dim_height_percent] -> [dim_width_percent] { dim_height_percent }
            }
        }
        false => {
            // unlink scale_styles: true <== resample && constrain ? scale_styles : false;
            relationship {
                method [resample_and_constrain] -> [scale_styles] { false }
            }
        }
    }

    // --- output / invariant ---

    out byte_count: i64 {
        method [dim_width_pixels, dim_height_pixels] {
            dim_width_pixels as i64 * dim_height_pixels as i64 * 32i64
        }
    }

    out result: (String, i32, i32, f64, bool, String) {
        method [
            resample,
            dim_width_pixels,
            dim_height_pixels,
            doc_resolution,
            scale_styles,
            resample_method
        ] {
            if resample {
                (
                    "resize_image",
                    dim_width_pixels,
                    dim_height_pixels,
                    doc_resolution,
                    scale_styles,
                    resample_method
                )
            } else {
                (
                    "set_resolution",
                    0,
                    0,
                    doc_resolution,
                    false,
                    ""
                )
            }
        }

        condition width_max [dim_width_pixels] { dim_width_pixels <= 300000 }
        condition height_max [dim_height_pixels] { dim_height_pixels <= 300000 }
    }
}
