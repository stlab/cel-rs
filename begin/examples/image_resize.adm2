//! 
//! Ported from ASL's classic `image_size` Adam sheet.
sheet image_resize {
    source original_width_pixels: i32 = 1600;
    source original_height_pixels = 1200;
    source original_resolution = 300.0;

    out original_width_inches := original_width_pixels as f64 / original_resolution;
    out original_height_inches := original_height_pixels as f64 / original_resolution;

    cell resample = true;
    cell constrain = true;
    cell scale_styles = true;

    cell resample_method = "bicubic";

    cell width_pixels = 1600;
    cell width_pixels_percent = 100.0;

    cell height_pixels = 1200;
    cell height_pixels_percent = 100.0;

    cell width_inches = 5.333333333333333;
    cell width_inches_percent = 100.0;

    cell resolution = 300.0;

    cell height_inches = 4.0;
    cell height_inches_percent = 100.0;

    cell auto_quality = "draft";

    cell screen_lpi = 300.0;

    relationship {
        width_inches := width_inches_percent * original_width_inches / 100.0;
        width_inches_percent := width_inches * 100.0 / original_width_inches;
    }

    relationship {
        height_inches := height_inches_percent * original_height_inches / 100.0;
        height_inches_percent := height_inches * 100.0 / original_height_inches;
    }

    relationship {
        screen_lpi := resolution / if auto_quality == "draft" { 1.0 } else if auto_quality == "good" { 1.5 } else { 2.0 };
        resolution := screen_lpi * if auto_quality == "draft" { 1.0 } else if auto_quality == "good" { 1.5 } else { 2.0 };
    }

    conditional resample {
        true => {
            relationship {
                width_pixels := round(width_pixels_percent * original_width_pixels as f64 / 100.0) as i32;
                width_pixels_percent := width_pixels as f64 * 100.0 / original_width_pixels as f64;
            }
            relationship {
                height_pixels := round(height_pixels_percent * original_height_pixels as f64 / 100.0) as i32;
                height_pixels_percent := height_pixels as f64 * 100.0 / original_height_pixels as f64;
            }
            relationship {
                width_inches := width_pixels as f64 / resolution;
                width_pixels := round(width_inches * resolution) as i32;
                resolution := width_pixels as f64 / width_inches;
            }
            relationship {
                height_inches := height_pixels as f64 / resolution;
                height_pixels := round(height_inches * resolution) as i32;
                resolution := height_pixels as f64 / height_inches;
            }
        }
        false => {
            relationship {
                constrain := true;
            }
            relationship {
                (width_pixels, width_pixels_percent) := (original_width_pixels, 100.0);
            }
            relationship {
                (height_pixels, height_pixels_percent) := (original_height_pixels, 100.0);
            }
            relationship {
                resolution := original_width_pixels as f64 / width_inches;
                width_inches := original_width_pixels as f64 / resolution;
            }
            relationship {
                resolution := original_height_pixels as f64 / height_inches;
                height_inches := original_height_pixels as f64 / resolution;
            }
        }
    }

    conditional resample && constrain {
        true => {
            relationship {
                height_pixels_percent := width_pixels_percent;
                width_pixels_percent := height_pixels_percent;
            }
        }
        false => {
            relationship {
                scale_styles := false;
            }
        }
    }

    out byte_count := width_pixels as i64 * height_pixels as i64 * 32i64;

    out result := if resample { ("resize_image", width_pixels, height_pixels, resolution, scale_styles, resample_method) } else { ("set_resolution", 0, 0, resolution, false, "") } require {
        width_max: width_pixels <= 300000;
        height_max: height_pixels <= 300000;
    };
}
