sheet demo {
    cell a: f64 = 2.0;
    cell b: f64 = 3.0;
    cell c: f64;
    cell d: f64 = 4.0;
    cell e: f64 = 5.0;
    cell f: f64;
    cell g = 0.0;
    cell p: i32 = 0;

    relate {
        c := a * b;
        a := c / b;
        b := c / a;
    }

    relate {
        f := d * e;
        d := f / e;
        e := f / d;
    }

    conditional p {
        0i32 => {
            relate {
                c := f;
                f := c;
            }
        }
        1i32 => {
            relate {
                c := f * 2.0;
                f := c / 2.0;
            }
            relate {
                g := c * 10.0;
            }
        }
        _ => {
            relate {
                c := f;
            }
        }
    }
}
