sheet diamond_wing {
    cell a = 0.0;
    cell b = 0.0;
    cell c = 0.0;
    cell d = 2.0;
    cell e = 3.0;

    relationship {
        method [b] -> [e] { b }
        method [e] -> [b] { e }
    }

    relationship {
        method [a, b] -> [c] { a * b }
        method [a, c] -> [b] { c / a }
        method [b, c] -> [a] { c / b }
    }

    relationship {
        method [b, c] -> [d] { b * c }
        method [b, d] -> [c] { d / b }
        method [c, d] -> [b] { d / c }
    }
}
