sheet diamond_wing {
    cell a = 0.0;
    cell b = 0.0;
    cell c = 0.0;
    cell d = 2.0;
    cell e = 3.0;

    relationship {
        e := b;
        b := e;
    }

    relationship {
        c := a * b;
        b := c / a;
        a := c / b;
    }

    relationship {
        d := b * c;
        c := d / b;
        b := d / c;
    }
}
