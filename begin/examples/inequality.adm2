sheet inequality {
    cell range = (0.0, 100.0);
    cell a = 0.0 filter clamp(_, range.0, range.1);
    cell b = 0.0 filter clamp(_, range.0, range.1);
    cell c = 2.0 filter clamp(_, range.0, range.1);

    relationship {
        a := min(a, b);
        b := max(a, b);
    }
    relationship {
        b := min(b, c);
        c := max(b, c);
    }
}
