sheet inequality {
    cell max_v = 100 filter 0..=200;
    cell a = 0 filter 0..=max_v;
    cell b = 42 filter 0..=max_v;
    cell c = 100 filter 0..=max_v;

    relationship {
        a := min(a, min(max_v, b));
        b := max(a, min(max_v, b));
    }
    relationship {
        b := min(b, min(max_v, c));
        c := max(b, min(max_v, c));
    }
}
