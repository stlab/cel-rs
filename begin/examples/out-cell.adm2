// out cell with condition and "don't care" value.
sheet out_cell {
    cell a = 0.0;
    cell b = 0.0;
    cell c = 0.0;
    cell p = false;

    conditional p {
        true => {
            relationship {
                method [c] -> [b] { c }
            }
        }
    }

    out result {
        method [a, b] { (a, b) }

        condition min_a [a, b] { a <= b }
    }
}
