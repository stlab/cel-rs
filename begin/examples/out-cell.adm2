// out cell with requirement and "don't care" value.
sheet out_cell {
    cell a = 0.0;
    cell b = 0.0;
    cell c = 0.0;
    cell p = false;

    conditional p {
        true => {
            relationship {
                b := c;
            }
        }
    }

    out result := (a, b) require {
        min_a: a <= b;
    };
}
