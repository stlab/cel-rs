{
  "name": "adam-slides",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test *.test.mjs",
    "build": "node build.mjs && marp dist/slides.md --html --theme-set slides.css --output dist/index.html",
    "watch:sources": "node --watch --watch-path=slides.md --watch-path=examples --watch-path=../adam-lang-book/book-src/examples --watch-path=build.mjs --watch-path=deck.mjs --watch-path=example.mjs --watch-path=example.html --watch-path=example.css build.mjs",
    "watch:marp": "marp dist/slides.md --no-stdin --html --theme-set slides.css --output dist/index.html --watch",
    "test:browser": "playwright test",
    "preview": "node tests/serve.mjs"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "@playwright/test": "1.64.0"
  },
  "overrides": {
    "basic-ftp": "6.2.2"
  }
}
