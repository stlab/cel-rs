{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "isBackground": false,
      "presentation": { "reveal": "silent" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cargo: install pm-lsp",
      "type": "shell",
      "command": "cargo",
      "args": ["install", "--path", "pm-lsp"],
      "options": { "cwd": "${workspaceFolder}/../.." },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "npm: package",
      "type": "npm",
      "script": "package",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "npm: install-extension",
      "type": "npm",
      "script": "install-extension",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Install pm-lsp + Extension (Local)",
      "dependsOrder": "sequence",
      "dependsOn": ["cargo: install pm-lsp", "npm: package", "npm: install-extension"],
      "problemMatcher": []
    }
  ]
}
