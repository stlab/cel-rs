sheet mode_demo {
    source p: i32 = 0;
    cell x: f64 = 1.0;
    cell y: f64 = 2.0;

    conditional p {
        0i32 => {
            relationship {
                x := y;
            }
        }
        1i32 => {
            relationship {
                y := x;
            }
        }
        _ => {
            relationship {
                x := 0.0;
            }
        }
    }
}
