{
    "adam-lang.modules": {
        "relationships": "adam-lang/examples/relationships.adm2",
        "composed": "adam-lang/examples/composed.adm2",
        "image_constraints": "cel-euclid/examples/image_constraints.adm2",
        "resize_straighten": "cel-euclid/examples/resize_straighten.adm2"
    },
    "editor.formatOnSave": true,
    "rust-analyzer.debug.engine": "vadimcn.vscode-lldb",
    "rust-analyzer.lens.debug.enable": true,
    "rust-analyzer.lens.enable": true,
    "rust-analyzer.lens.run.enable": true,
    "rust-analyzer.testExplorer": true,
    "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
    "cSpell.words": [
        "concatenative",
        "Peekable"
    ],
    "cSpell.useGitignore": false,
    "rust-analyzer.cargo.features": [
        "playground"
    ],
    "taskManager.favorites": [
        "cel-rs/Workspace/slides: serve (full)",
        "cel-rs/Workspace/Install adam-lsp + Extension (Local)",
        "cel-rs/Workspace/begin: serve (desktop)",
        "cel-rs/Workspace/begin: serve (web)",
        "cel-rs/Workspace/book: serve (full)",
        "cel-rs/Workspace/cel-lang-book: serve"
    ],
    "cmake.ignoreCMakeListsMissing": true
}
